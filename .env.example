# Copy to .env.local (not committed) and fill in. Restart `next dev` after changing a value.

# Server-only. Not needed while NEXT_PUBLIC_USE_MOCK_CHAT is true.
GEMINI_API_KEY=

# Server-only. Only needed when TTS_PROVIDER=google (Google Cloud Text-to-Speech).
# Not the same key as GEMINI_API_KEY: this one needs the Text-to-Speech API enabled.
GOOGLE_CLOUD_API_KEY=

# Server-only. Only needed when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=

# Server-only. Used by /api/stt/token to mint a short-lived token for the browser, which
# then connects to Deepgram directly. The key needs the Member role or higher, or the
# token request is refused.
DEEPGRAM_API_KEY=

# Server-only. Only needed when TTS_PROVIDER=azure (Azure AI Speech).
AZURE_SPEECH_API_KEY=
# The region of the Azure Speech resource, which is part of the API hostname.
## e.g. swedencentral
AZURE_SPEECH_REGION=

# Which text-to-speech provider /api/tts uses: azure, google or elevenlabs.
# An unknown value fails loudly, listing the valid names.
TTS_PROVIDER=azure

# true: the chat and evaluation drivers call /api/mock/chat and /api/mock/evaluation
# (canned replies and corrections, no Gemini call).
# NEXT_PUBLIC_ values are inlined into the client at build time, so a change needs a restart.
# The mock only works under `next dev`; in any other mode the mock route answers 404.
NEXT_PUBLIC_USE_MOCK_CHAT=false

# true: the AI's turn is "spoken" by a timer instead of /api/tts (no audio, no TTS call).
# Also a NEXT_PUBLIC_ value, so it needs a restart. Unlike the chat mock it is not limited
# to `next dev`, because it runs in the browser.
NEXT_PUBLIC_USE_MOCK_TTS=false
